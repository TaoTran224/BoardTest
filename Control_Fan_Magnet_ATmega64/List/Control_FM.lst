                 ;void PWM1_DeInit(void)
                 ; 0001 0120 {
                 _PWM1_DeInit:
                 ; 0001 0121     // 1. Ng?t k?t n?i PWM kh?i chân OC1A
                 ; 0001 0122     TCCR1A &= ~((1 << COM1A1) | (1 << COM1A0));
000147 b5ef      	IN   R30,0x2F
000148 73ef      	ANDI R30,LOW(0x3F)
000149 bdef      	OUT  0x2F,R30
                 ; 0001 0123 
                 ; 0001 0124     // 2. D?ng Timer (clear prescaler)
                 ; 0001 0125     TCCR1B &= ~((1 << CS12) | (1 << CS11) | (1 << CS10));
00014a b5ee      	IN   R30,0x2E
00014b 7fe8      	ANDI R30,LOW(0xF8)
00014c bdee      	OUT  0x2E,R30
                 ; 0001 0126 
                 ; 0001 0127     // 3. Reset toàn b? thanh ghi Timer1 v? m?c d?nh
                 ; 0001 0128     TCCR1A = 0x00;
00014d e0e0      	LDI  R30,LOW(0)
00014e bdef      	OUT  0x2F,R30
                 ; 0001 0129     TCCR1B = 0x00;
00014f bdee      	OUT  0x2E,R30
                 ; 0001 012A     TCCR1C = 0x00;
000150 93e0 007a 	STS  122,R30
                 ; 0001 012B 
                 ; 0001 012C     // 4. Reset counter và compare
                 ; 0001 012D     TCNT1 = 0x0000;
000152 e0e0      	LDI  R30,LOW(0)
000153 e0f0      	LDI  R31,HIGH(0)
000154 bdfd      	OUT  0x2C+1,R31
000155 bdec      	OUT  0x2C,R30
                 ; 0001 012E     ICR1  = 0x0000;
000156 bdf7      	OUT  0x26+1,R31
000157 bde6      	OUT  0x26,R30
                 ; 0001 012F     OCR1A = 0x0000;
000158 bdfb      	OUT  0x2A+1,R31
000159 bdea      	OUT  0x2A,R30
                 ; 0001 0130     OCR1B = 0x0000;
00015a bdf9      	OUT  0x28+1,R31
00015b bde8      	OUT  0x28,R30
                 ; 0001 0131 
                 ; 0001 0132     // 5. Clear interrupt flags (n?u có)
                 ; 0001 0133     TIFR  |= (1 << TOV1) | (1 << OCF1A) | (1 << OCF1B) | (1 << ICF1);
00015c b7e6      	IN   R30,0x36
00015d 63ec      	ORI  R30,LOW(0x3C)
00015e bfe6      	OUT  0x36,R30
                 ; 0001 0134 
                 ; 0001 0135     // 6. Disable interrupt Timer1 (n?u b?n có dùng)
                 ; 0001 0136     TIMSK &= ~((1 << TOIE1) | (1 << OCIE1A) | (1 << OCIE1B) | (1 << TICIE1));
00015f b7e7      	IN   R30,0x37
000160 7ce3      	ANDI R30,LOW(0xC3)
000161 bfe7      	OUT  0x37,R30
                 ; 0001 0137 }
000162 9508      	RET
