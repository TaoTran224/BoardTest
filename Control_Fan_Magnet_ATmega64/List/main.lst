                 ;
                 ;
                 ;// multiply by 2 in the galois field
                 ;unsigned char galois_mul2(unsigned char value)
                 ; 0005 0059 {
                 
                 	.CSEG
                 _galois_mul2:
                 ; 0005 005A   signed char temp;
                 ; 0005 005B   // cast to signed value
                 ; 0005 005C   temp = (signed char) value;
001299 931a      	ST   -Y,R17
                 ;	value -> Y+1
                 ;	temp -> R17
00129a 8119      	LDD  R17,Y+1
                 ; 0005 005D   // if MSB is 1, then this will signed extend and fill the temp variable with 1's
                 ; 0005 005E   temp = temp >> 7;
00129b 2fa1      	MOV  R26,R17
00129c e0b0      	LDI  R27,0
00129d fda7      	SBRC R26,7
00129e efbf      	SER  R27
00129f e0e7      	LDI  R30,LOW(7)
0012a0 940e 231e 	CALL __ASRW12
0012a2 2f1e      	MOV  R17,R30
                 ; 0005 005F   // AND with the reduction variable
                 ; 0005 0060   temp = temp & 0x1b;
0012a3 711b      	ANDI R17,LOW(27)
                 ; 0005 0061   // finally shift and reduce the value
                 ; 0005 0062   return ((value << 1)^temp);
0012a4 81e9      	LDD  R30,Y+1
0012a5 0fee      	LSL  R30
0012a6 27e1      	EOR  R30,R17
0012a7 8118      	LDD  R17,Y+0
0012a8 9622      	ADIW R28,2
0012a9 9508      	RET
                 ; 0005 0063 }
                 ;
                 ;// AES encryption and decryption function
                 ;// The code was optimized for memory (flash and ram)
                 ;// Combining both encryption and decryption resulted in a slower implementation
                 ;// but much smaller than the 2 functions separated
                 ;// This function only implements AES-128 encryption and decryption (AES-192 and
                 ;// AES-256 are not supported by this code)
                 ;void aes_enc_dec(unsigned char *state, unsigned char *key, unsigned char dir)
                 ; 0005 006C {
                 _aes_enc_dec:
                 ; 0005 006D   unsigned char buf1, buf2, buf3, buf4, round, i;
                 ; 0005 006E 
                 ; 0005 006F   // In case of decryption
                 ; 0005 0070   if (dir) {
0012aa 940e 2417 	CALL __SAVELOCR6
                 ;	*state -> Y+9
                 ;	*key -> Y+7
                 ;	dir -> Y+6
                 ;	buf1 -> R17
                 ;	buf2 -> R16
                 ;	buf3 -> R19
                 ;	buf4 -> R18
                 ;	round -> R21
                 ;	i -> R20
0012ac 81ee      	LDD  R30,Y+6
0012ad 30e0      	CPI  R30,0
0012ae f111      	BREQ _0xA0006
                 ; 0005 0071     // compute the last key of encryption before starting the decryption
                 ; 0005 0072     for (round = 0 ; round < 10; round++) {
0012af e050      	LDI  R21,LOW(0)
                 _0xA0008:
0012b0 305a      	CPI  R21,10
0012b1 f490      	BRSH _0xA0009
                 ; 0005 0073       //key schedule
                 ; 0005 0074       key[0] = sbox[key[13]]^key[0]^Rcon[round];
0012b2 940e 1f95 	CALL SUBOPT_0x89
0012b4 2da0      	MOV  R26,R0
0012b5 27ae      	EOR  R26,R30
0012b6 940e 1dd7 	CALL SUBOPT_0x50
0012b8 940e 1fa1 	CALL SUBOPT_0x8A
                 ; 0005 0075       key[1] = sbox[key[14]]^key[1];
                 ; 0005 0076       key[2] = sbox[key[15]]^key[2];
                 ; 0005 0077       key[3] = sbox[key[12]]^key[3];
                 ; 0005 0078       for (i=4; i<16; i++) {
                 _0xA000B:
0012ba 3140      	CPI  R20,16
0012bb f430      	BRSH _0xA000C
                 ; 0005 0079         key[i] = key[i] ^ key[i-4];
0012bc 940e 1fdb 	CALL SUBOPT_0x8B
0012be 940e 1fdf 	CALL SUBOPT_0x8C
                 ; 0005 007A       }
0012c0 5f4f      	SUBI R20,-1
0012c1 cff8      	RJMP _0xA000B
                 _0xA000C:
                 ; 0005 007B     }
0012c2 5f5f      	SUBI R21,-1
0012c3 cfec      	RJMP _0xA0008
                 _0xA0009:
                 ; 0005 007C 
                 ; 0005 007D     //first Addroundkey
                 ; 0005 007E     for (i = 0; i <16; i++){
0012c4 e040      	LDI  R20,LOW(0)
                 _0xA000E:
0012c5 3140      	CPI  R20,16
0012c6 f450      	BRSH _0xA000F
                 ; 0005 007F       state[i]=state[i] ^ key[i];
0012c7 940e 1fee 	CALL SUBOPT_0x8D
0012c9 940e 1ff2 	CALL SUBOPT_0x8E
0012cb 940e 1ffa 	CALL SUBOPT_0x8F
0012cd 940e 1f65 	CALL SUBOPT_0x7F
                 ; 0005 0080     }
0012cf 5f4f      	SUBI R20,-1
0012d0 cff4      	RJMP _0xA000E
                 _0xA000F:
                 ; 0005 0081   }
                 ; 0005 0082 
                 ; 0005 0083   // main loop
                 ; 0005 0084   for (round = 0; round < 10; round++){
                 _0xA0006:
0012d1 e050      	LDI  R21,LOW(0)
                 _0xA0011:
0012d2 305a      	CPI  R21,10
0012d3 f010      	BRLO PC+3
0012d4 940c 14ae 	JMP _0xA0012
                 ; 0005 0085     if (dir){
0012d6 81ee      	LDD  R30,Y+6
0012d7 30e0      	CPI  R30,0
0012d8 f411      	BRNE PC+3
0012d9 940c 1319 	JMP _0xA0013
                 ; 0005 0086       //Inverse key schedule
                 ; 0005 0087       for (i=15; i>3; --i) {
0012db e04f      	LDI  R20,LOW(15)
                 _0xA0015:
0012dc 3044      	CPI  R20,4
0012dd f030      	BRLO _0xA0016
                 ; 0005 0088   key[i] = key[i] ^ key[i-4];
0012de 940e 1fdb 	CALL SUBOPT_0x8B
0012e0 940e 1fdf 	CALL SUBOPT_0x8C
                 ; 0005 0089       }
0012e2 5041      	SUBI R20,LOW(1)
0012e3 cff8      	RJMP _0xA0015
                 _0xA0016:
                 ; 0005 008A       key[0] = sbox[key[13]]^key[0]^Rcon[9-round];
0012e4 940e 1f95 	CALL SUBOPT_0x89
0012e6 260e      	EOR  R0,R30
0012e7 940e 1dd7 	CALL SUBOPT_0x50
0012e9 e0a9      	LDI  R26,LOW(9)
0012ea e0b0      	LDI  R27,HIGH(9)
0012eb 940e 23fd 	CALL __SWAPW12
0012ed 1bea      	SUB  R30,R26
0012ee 0bfb      	SBC  R31,R27
0012ef 5be8      	SUBI R30,LOW(-_Rcon)
0012f0 4ff6      	SBCI R31,HIGH(-_Rcon)
0012f1 81e0      	LD   R30,Z
0012f2 25e0      	EOR  R30,R0
0012f3 81af      	LDD  R26,Y+7
0012f4 85b8      	LDD  R27,Y+7+1
0012f5 93ec      	ST   X,R30
                 ; 0005 008B       key[1] = sbox[key[14]]^key[1];
0012f6 961e      	ADIW R26,14
0012f7 940e 2000 	CALL SUBOPT_0x90
0012f9 9611      	ADIW R26,1
0012fa 91ec      	LD   R30,X
0012fb 25e0      	EOR  R30,R0
                +
0012fc 81af     +LDD R26 , Y + 7
0012fd 85b8     +LDD R27 , Y + 7 + 1
0012fe 9611     +ADIW R26 , 1
0012ff 93ec     +ST X , R30
                 	__PUTB1SNS 7,1
                 ; 0005 008C       key[2] = sbox[key[15]]^key[2];
001300 81af      	LDD  R26,Y+7
001301 85b8      	LDD  R27,Y+7+1
001302 961f      	ADIW R26,15
001303 940e 2000 	CALL SUBOPT_0x90
001305 9612      	ADIW R26,2
001306 91ec      	LD   R30,X
001307 25e0      	EOR  R30,R0
                +
001308 81af     +LDD R26 , Y + 7
001309 85b8     +LDD R27 , Y + 7 + 1
00130a 9612     +ADIW R26 , 2
00130b 93ec     +ST X , R30
                 	__PUTB1SNS 7,2
                 ; 0005 008D       key[3] = sbox[key[12]]^key[3];
00130c 81af      	LDD  R26,Y+7
00130d 85b8      	LDD  R27,Y+7+1
00130e 961c      	ADIW R26,12
00130f 940e 2000 	CALL SUBOPT_0x90
001311 9613      	ADIW R26,3
001312 91ec      	LD   R30,X
001313 25e0      	EOR  R30,R0
                +
001314 81af     +LDD R26 , Y + 7
001315 85b8     +LDD R27 , Y + 7 + 1
001316 9613     +ADIW R26 , 3
001317 93ec     +ST X , R30
                 	__PUTB1SNS 7,3
                 ; 0005 008E     } else {
001318 c06f      	RJMP _0xA0017
                 _0xA0013:
                 ; 0005 008F       for (i = 0; i <16; i++){
001319 e040      	LDI  R20,LOW(0)
                 _0xA0019:
00131a 3140      	CPI  R20,16
00131b f490      	BRSH _0xA001A
                 ; 0005 0090         // with shiftrow i+5 mod 16
                 ; 0005 0091   state[i]=sbox[state[i] ^ key[i]];
00131c 940e 1fee 	CALL SUBOPT_0x8D
00131e 940e 1ff2 	CALL SUBOPT_0x8E
001320 2411      	CLR  R1
001321 940e 1ffa 	CALL SUBOPT_0x8F
001323 940e 2008 	CALL SUBOPT_0x91
001325 25e0      	EOR  R30,R0
001326 25f1      	EOR  R31,R1
001327 5be8      	SUBI R30,LOW(-_sbox)
001328 4ff8      	SBCI R31,HIGH(-_sbox)
001329 81e0      	LD   R30,Z
00132a 01db      	MOVW R26,R22
00132b 93ec      	ST   X,R30
                 ; 0005 0092       }
00132c 5f4f      	SUBI R20,-1
00132d cfec      	RJMP _0xA0019
                 _0xA001A:
                 ; 0005 0093       //shift rows
                 ; 0005 0094       buf1 = state[1];
00132e 85a9      	LDD  R26,Y+9
00132f 85ba      	LDD  R27,Y+9+1
001330 9611      	ADIW R26,1
001331 911c      	LD   R17,X
                 ; 0005 0095       state[1] = state[5];
001332 85a9      	LDD  R26,Y+9
001333 85ba      	LDD  R27,Y+9+1
001334 9615      	ADIW R26,5
001335 91ec      	LD   R30,X
                +
001336 85a9     +LDD R26 , Y + 9
001337 85ba     +LDD R27 , Y + 9 + 1
001338 9611     +ADIW R26 , 1
001339 93ec     +ST X , R30
                 	__PUTB1SNS 9,1
                 ; 0005 0096       state[5] = state[9];
00133a 85a9      	LDD  R26,Y+9
00133b 85ba      	LDD  R27,Y+9+1
00133c 9619      	ADIW R26,9
00133d 91ec      	LD   R30,X
                +
00133e 85a9     +LDD R26 , Y + 9
00133f 85ba     +LDD R27 , Y + 9 + 1
001340 9615     +ADIW R26 , 5
001341 93ec     +ST X , R30
                 	__PUTB1SNS 9,5
                 ; 0005 0097       state[9] = state[13];
001342 85a9      	LDD  R26,Y+9
001343 85ba      	LDD  R27,Y+9+1
001344 961d      	ADIW R26,13
001345 91ec      	LD   R30,X
                +
