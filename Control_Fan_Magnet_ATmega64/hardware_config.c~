static void Timer0Init(void)
{
    ASSR=0x00;
    OCR0=0x00;
    TCCR0=0x04;             // Prescaling = 64
    TCNT0=131;               // 56 <=>1.6ms;  131 <=>1 ms
    TIMSK |= (1<<TOIE0);    // TC0 overflow interrupt enable
}

