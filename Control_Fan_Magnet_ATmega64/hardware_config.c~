void UART0SendChar(uint8_t c)
{
    while(!(UCSR0A & DATA_REGISTER_EMPTY)) {}
    UDR0=c;
}

void UART0SendBuffer(uint8_t *buffer, uint16_t len)
{
    uint16_t i=0;
    #asm("cli")
    for(i=0; i<len;i++)
    {
        UART0SendChar(buffer[i]);
    }
    #asm("sei")
}

