        // 3. Hàm khởi tạo và kết nối cổng COM
        private void InitSerialPort(string portName, int baudRate = 9600)
        {
            try
            {
                if (serialPort1.IsOpen)
                    serialPort1.Close();

                serialPort1.PortName = portName; // VD: "COM3"
                serialPort1.BaudRate = baudRate;
                serialPort1.DataBits = 8;
                serialPort1.StopBits = StopBits.One;
                serialPort1.Parity = Parity.None;

                // Đăng ký sự kiện nhận dữ liệu tự động
                serialPort1.DataReceived += SerialPort1_DataReceived;

                serialPort1.Open();
                PrintLog(null, $"Mở thành công cổng {portName}", "SEND");
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Lỗi mở cổng COM: {ex.Message}");
            }
        }
        void SearchCOM()
        {
            string[] ComList = SerialPort.GetPortNames();
            int[] ComNumberList = new int[ComList.Length];
            Tbox_ComWM.Items.Clear();
            Tbox_ComWM.Text = "";
            if (ComList.Length == 0)
            {
                MessageBox.Show("Không tìm thấy cổng COM. Kiểm tra lại cổng COM.", "Lỗi", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
            else
            {
                for (int i = 0; i < ComList.Length; i++)
                {
                    ComNumberList[i] = int.Parse(ComList[i].Substring(3));
                }
                Array.Sort(ComNumberList);
                foreach (int ComNumber in ComNumberList)
                {
                    Tbox_ComWM.Items.Add("COM" + ComNumber.ToString());
                    Tbox_ComWM.Text = "COM" + ComNumber.ToString();//COM_Port.PortName;
                }
                //COM_Port.PortName = Tbox_ComWM.Text;
            }
        }

        // 4. Sự kiện tự động chạy khi nhận dữ liệu UART từ thiết bị
        private void SerialPort1_DataReceived(object sender, SerialDataReceivedEventArgs e)
        {
            int bytesToRead = serialPort1.BytesToRead;
            byte[] buffer = new byte[bytesToRead];
            serialPort1.Read(buffer, 0, bytesToRead);

            // Chuyển dữ liệu về Thread giao diện (UI) để cập nhật RichTextBox
            this.Invoke(new Action(() =>
            {
                PrintLog(buffer, "ĐỌC DỮ LIỆU UART", "RECV");
            }));
        }

